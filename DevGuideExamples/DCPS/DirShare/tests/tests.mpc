// MPC file for DirShare unit tests


// Boost.Test unit tests

project(*ChecksumBoostTest): aceexe, dcps {
  exename = ChecksumBoostTest
  after  += DirShare_lib

  libs += DirShare
  libpaths += ..

  includes += /opt/homebrew/include

  Source_Files {
    ChecksumBoostTest.cpp
  }

  Header_Files {
  }

  // Boost.Test configuration
  // Note: Boost.Test is header-only with BOOST_TEST_INCLUDED
  // No additional libs needed with included/unit_test.hpp
}

