// MPC file for DirShare unit tests

project(*ChecksumTest): aceexe, dcps {
  exename = ChecksumTest
  after  += DirShare_lib

  libs += DirShare
  libpaths += ..

  Source_Files {
    ChecksumTest.cpp
  }

  Header_Files {
  }
}

